<div id="preloader" aria-label="Loading animation">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" preserveAspectRatio="xMidYMid meet" width="100%" height="100%" role="img" aria-hidden="true">
    <defs>
      <mask id="flightPathMask">
        <rect width="100%" height="100%" fill="black" />
        <path
          id="flightPathReveal"
          class="flight-path-reveal"
          d="
            M -950,420
            C -820,420 -700,400 -560,380
            C -420,360 -300,365 -180,388
            C -120,399 -70,395 -10,390
            C 50,390 100,460 50,460
            C 0,460 10,400 60,410
            C 100,420 110,360 115,330
            C 120,280 120,210 125,160
            C 130,110 180,100 230,100
            C 280,100 290,150 250,150
            C 210,150 220,95 260,100
            C 290,105 315,115 340,115
            C 365,116 395,128 425,148"
        />
      </mask>
    </defs>

    <rect width="100%" height="100%" fill="#050505" />

    <path
      id="flightPath"
      class="flight-path"
      mask="url(#flightPathMask)"
      d="
        M -950,420
        C -820,420 -700,400 -560,380
        C -420,360 -300,365 -180,388
        C -120,399 -70,395 -10,390
        C 50,390 100,460 50,460
        C 0,460 10,400 60,410
        C 100,420 110,360 115,330
        C 120,280 120,210 125,160
        C 130,110 180,100 230,100
        C 280,100 290,150 250,150
        C 210,150 220,95 260,100
        C 290,105 315,115 340,115
        C 365,116 395,128 425,148"
    />

    <g class="red-shape">
      <path d="M 230,160 L 135,160 A 45,45 0 0 0 90,205 L 230,205 Z" />
      <rect x="90" y="220" width="140" height="45" />
      <path d="M 420,280 L 90,280 A 45,45 0 0 0 135,325 L 420,325 Z" />
    </g>

    <text id="cellText" x="240" y="265" class="text-cell">CELL</text>
    <text id="vjitText" x="325" y="312" class="text-vjit" text-anchor="middle">VJIT</text>

    <g id="rocket" transform="translate(340, 75)">
      <polygon points="0,40 55,0 40,45 15,35" fill="#FFFFFF" />
      <polygon points="15,35 40,45 20,55" fill="#FFFFFF" />
      <polygon points="15,35 55,0 25,38" fill="#E0E0E0" />
    </g>
  </svg>
</div>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: #050505;
    opacity: 1;
    visibility: visible;
  }

  #preloader svg {
    width: 100vw;
    height: 100vh;
    display: block;
  }

  #preloader.is-done {
    opacity: 0;
    visibility: hidden;
    transition: opacity 350ms ease, visibility 350ms ease;
  }

  .flight-path {
    fill: none;
    stroke: #ffffff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 4 6;
    stroke-dashoffset: 0;
  }

  .flight-path-reveal {
    fill: none;
    stroke: white;
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 0;
    stroke-dashoffset: 0;
  }

  .red-shape {
    fill: #da2128;
  }

  .text-cell {
    font-family: "Arial Black", Impact, sans-serif;
    font-weight: 900;
    font-size: 80px;
    fill: #ffffff;
    letter-spacing: 2px;
    opacity: 0;
    transform: translateY(14px);
    transform-box: fill-box;
    transition: opacity 450ms ease, transform 450ms ease;
  }

  .text-vjit {
    font-family: Georgia, serif;
    font-weight: bold;
    font-size: 24px;
    fill: #ffffff;
    letter-spacing: 6px;
    opacity: 0;
    transform: translateY(14px);
    transform-box: fill-box;
    transition: opacity 450ms ease 90ms, transform 450ms ease 90ms;
  }

  #preloader.show-wordmark .text-cell,
  #preloader.show-wordmark .text-vjit {
    opacity: 1;
    transform: translateY(0);
  }

  #rocket {
    transform-box: fill-box;
    transform-origin: center;
    will-change: transform;
  }
</style>

<script is:inline>
  (() => {
    const preloader = document.getElementById("preloader");
    const finish = () => {
      document.body.classList.remove("loading");
      preloader?.classList.add("is-done");
      window.setTimeout(() => preloader?.remove(), 400);
    };
    if (!preloader || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      finish();
      return;
    }
    const flightPath = document.getElementById("flightPath");
    const flightPathReveal = document.getElementById("flightPathReveal");
    const rocket = document.getElementById("rocket");
    if (!flightPath || !flightPathReveal || !rocket) {
      finish();
      return;
    }
    const totalLength = flightPathReveal.getTotalLength();
    const duration = 2600;
    const startDistance = Array.from({ length: 101 }, (_, index) => totalLength * index / 100)
      .find((distance) => flightPath.getPointAtLength(distance).x >= -50) ?? 0;
    flightPathReveal.style.strokeDasharray = String(totalLength);
    flightPathReveal.style.strokeDashoffset = String(totalLength - startDistance);

    const moveRocket = (distance) => {
      const point = flightPath.getPointAtLength(distance);
      const next = flightPath.getPointAtLength(Math.min(totalLength, distance + 3));
      const angle = Math.atan2(next.y - point.y, next.x - point.x) * 180 / Math.PI + 36;
      rocket.setAttribute("transform", `translate(${point.x - 25}, ${point.y - 25}) rotate(${angle}, 25, 25)`);
    };
    moveRocket(startDistance);
    const startTime = performance.now();
    const animate = (now) => {
      const progress = Math.min(1, (now - startTime) / duration);
      const eased = 0.5 - Math.cos(Math.PI * progress) / 2;
      const distance = startDistance + (totalLength - startDistance) * eased;
      flightPathReveal.style.strokeDashoffset = String(totalLength - distance);
      moveRocket(distance);
      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        preloader.classList.add("show-wordmark");
        window.setTimeout(finish, 650);
      }
    };
    requestAnimationFrame(animate);
  })();
</script>
<noscript><style>#preloader { display: none !important; }</style></noscript>
