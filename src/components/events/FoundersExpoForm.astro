---
interface Props { eventId: string; eventSlug: string }
const { eventId, eventSlug } = Astro.props as Props;
---

<form id="founders-expo-form" class="expo-form" data-event-id={eventId} data-event-slug={eventSlug}>
  <div class="expo-heading"><h2>Stall registration</h2><p>₹149 per stall · one idea or startup per stall · up to 3 members</p></div>
  <div class="expo-grid">
    <label>Team lead name<input name="name" autocomplete="name" maxlength="120" required /></label>
    <label>Contact number<input name="phone" type="tel" autocomplete="tel" maxlength="40" required /></label>
    <label>Email address<input name="email" type="email" autocomplete="email" maxlength="320" required /></label>
    <label>Year of study<select name="year_of_study" required><option value="">Select</option><option>I</option><option>II</option><option>III</option><option>IV</option><option>I am not a student</option></select></label>
    <label>Branch<select name="branch" id="expo-branch" required><option value="">Select</option><option>CSE</option><option>IT</option><option>CSE(DS)</option><option>CSE(AIML)</option><option>AI&amp;DS</option><option>AI</option><option>EEE</option><option>ECE</option><option>MECH</option><option>CIVIL</option><option value="Other">Other</option></select></label>
    <label id="expo-other-wrap" hidden>Other branch<input name="branch_other" maxlength="80" /></label>
    <label>Section<select name="section" required><option value="">Select</option><option>A</option><option>B</option><option>C</option><option>D</option><option value="Not applicable">Not applicable</option></select></label>
    <label>College / organization<input name="college" maxlength="200" required /></label>
    <label class="expo-wide">Team, startup, or idea name<input name="team_name" maxlength="120" required /></label>
    <label>Team size<select name="team_size" id="expo-team-size" required><option value="1">1 member</option><option value="2">2 members</option><option value="3">3 members</option></select></label>
    <label class="expo-member" data-member="1" hidden>Team member 2 name<input name="member_1" maxlength="120" /></label>
    <label class="expo-member" data-member="2" hidden>Team member 3 name<input name="member_2" maxlength="120" /></label>
  </div>
  <label class="expo-confirm"><input type="checkbox" name="single_idea_per_stall" required /> I confirm that this stall represents only one idea or startup. A separate stall registration is required for each idea.</label>
  <div class="expo-payment-block">
    <p class="expo-payment">Pay the fixed fee of <strong>₹149 per stall</strong> using this QR code. Enter the transaction ID from your payment app below before submitting.</p>
    <img class="expo-payment-qr" src="/images/events/founders-expo-payment-qr.png" alt="Payment QR code for the Founders Expo registration fee" loading="lazy" width="240" height="240" />
  </div>
  <label class="expo-transaction">Payment transaction ID<input name="payment_transaction_id" autocomplete="off" minlength="4" maxlength="120" placeholder="UPI transaction ID / UTR" required /><small>We will verify the payment against this reference.</small></label>
  <p class="expo-status" id="expo-status" role="status" aria-live="polite"></p>
  <button class="expo-submit" type="submit">Register one stall</button>
</form>

<style>
  .expo-form { display:grid; gap:1.25rem; color:#f4eeee; font-family:var(--font-inter); }
  .expo-heading h2 { margin:0 0 .35rem; font:600 1.25rem var(--font-jakarta); }
  .expo-heading p,.expo-payment { margin:0; color:#d6b8b8; font-size:.9rem; }
  .expo-payment-block { display:grid; gap:.8rem; }
  .expo-payment strong { color:#fff; }
  .expo-payment-qr { width:240px; max-width:100%; aspect-ratio:1; padding:8px; background:white; border-radius:4px; }
  .expo-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .expo-grid label { display:grid; gap:.45rem; font-size:.85rem; color:#e7dada; }
  .expo-grid input,.expo-grid select { min-width:0; width:100%; padding:.75rem .85rem; color:white; background:rgba(255,255,255,.045); border:1px solid rgba(255,255,255,.17); border-radius:4px; }
  .expo-grid select option { color:#181010; }
  .expo-wide { grid-column:1/-1; }
  .expo-confirm { display:flex; align-items:flex-start; gap:.65rem; font-size:.9rem; line-height:1.5; }
  .expo-confirm input { margin-top:.2rem; accent-color:#e74739; }
  .expo-transaction { display:grid; gap:.45rem; max-width:34rem; font-size:.9rem; color:#e7dada; }
  .expo-transaction input { width:100%; padding:.75rem .85rem; color:white; background:rgba(255,255,255,.045); border:1px solid rgba(255,255,255,.17); border-radius:4px; }
  .expo-transaction small { color:#bca6a6; }
  .expo-status:empty { display:none; }
  .expo-status { margin:0; color:#ffaaa3; }
  .expo-submit { justify-self:start; border:1px solid #f06c5e; border-radius:4px; padding:.8rem 1.1rem; color:white; background:#a82a20; font-weight:600; cursor:pointer; }
  .expo-submit:disabled { opacity:.6; cursor:wait; }
  @media(max-width:600px) { .expo-grid { grid-template-columns:1fr; } .expo-wide { grid-column:auto; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#founders-expo-form');
  const size = document.querySelector<HTMLSelectElement>('#expo-team-size');
  const branch = document.querySelector<HTMLSelectElement>('#expo-branch');
  const otherWrap = document.querySelector<HTMLElement>('#expo-other-wrap');
  const syncMembers = () => {
    const teamSize = Number(size?.value ?? 1);
    document.querySelectorAll<HTMLElement>('.expo-member').forEach((field) => {
      const visible = Number(field.dataset.member) < teamSize;
      field.hidden = !visible;
      const input = field.querySelector<HTMLInputElement>('input');
      if (input) { input.required = visible; if (!visible) input.value = ''; }
    });
  };
  size?.addEventListener('change', syncMembers);
  branch?.addEventListener('change', () => {
    if (!otherWrap) return;
    otherWrap.hidden = branch.value !== 'Other';
    const input = otherWrap.querySelector<HTMLInputElement>('input');
    if (input) input.required = branch.value === 'Other';
  });
  syncMembers();
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = document.querySelector<HTMLElement>('#expo-status');
    const data = new FormData(form);
      const teamSize = Number(data.get('team_size'));
      const transactionId = String(data.get('payment_transaction_id') ?? '').trim();
      const branchValue = data.get('branch') === 'Other' ? data.get('branch_other') : data.get('branch');
    if (button) button.disabled = true;
    if (status) status.textContent = 'Submitting registration…';
    try {
      const response = await fetch('/api/register-event', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ eventId:form.dataset.eventId, rows:[{
          name:data.get('name'), email:data.get('email'), phone:data.get('phone'),
          year_of_study:data.get('year_of_study'), branch:branchValue, section:data.get('section'),
          college:data.get('college'), team_name:data.get('team_name'),
          extra_data:{ form_variant:'founders-expo', team_size:teamSize,
            member_names:Array.from({length:teamSize-1},(_,index)=>data.get(`member_${index+1}`)),
            payment_transaction_id:transactionId,
            single_idea_per_stall:data.get('single_idea_per_stall')==='on' },
        }] }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? 'Could not complete registration.');
      const ticketIds = (result.registrations ?? []).map((item: {ticket_id:string})=>item.ticket_id).filter(Boolean);
      const ticketList = ticketIds.join(',');
      let fragment='';
      try { sessionStorage.setItem(`ecell-ticket-access:${ticketList}`,result.accessToken); }
      catch { fragment=`#access=${encodeURIComponent(result.accessToken)}`; }
      window.location.href=`/events/${form.dataset.eventSlug}/confirmation?tickets=${ticketList}${fragment}`;
    } catch (error) {
      if (status) status.textContent=error instanceof Error?error.message:'Could not complete registration.';
      if (button) button.disabled=false;
    }
  });
</script>
